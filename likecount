<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Like Count Filter</title>

<style>
    * {
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background: #f5f5f5;
        padding: 20px;
    }

    .container {
        max-width: 1000px;
        margin: auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,.1);
    }

    h2 {
        margin-top: 0;
    }

    .row {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        align-items: center;
        flex-wrap: wrap;
    }

    input[type="number"] {
        width: 120px;
        padding: 8px;
    }

    textarea {
        width: 100%;
        height: 250px;
        resize: vertical;
        padding: 10px;
    }

    button {
        padding: 10px 20px;
        cursor: pointer;
    }

    label {
        display: flex;
        align-items: center;
        gap: 5px;
    }
</style>
</head>
<body>

<div class="container">
    <h2>Like Count Filter</h2>

    <p><b>Input</b> (mỗi dòng: <code>id|like_count</code>)</p>
    <textarea id="inputData" placeholder="123|150&#10;456|300&#10;789|50"></textarea>

    <div class="row">
        <label>
            Min Like:
            <input type="number" id="minLike" value="0">
        </label>

        <label>
            Max Like:
            <input type="number" id="maxLike" value="999999999">
        </label>

        <label>
            <input type="checkbox" id="excludeLike">
            Exclude Like Count
        </label>

        <button onclick="filterData()">Lọc</button>
    </div>

    <p><b>Export</b></p>
    <textarea id="outputData" readonly></textarea>
</div>

<script>
function filterData() {
    const input = document.getElementById("inputData").value.trim();
    const minLike = parseInt(document.getElementById("minLike").value) || 0;
    const maxLike = parseInt(document.getElementById("maxLike").value) || Number.MAX_SAFE_INTEGER;
    const excludeLike = document.getElementById("excludeLike").checked;

    const lines = input.split(/\r?\n/);
    const result = [];

    for (const line of lines) {
        if (!line.trim()) continue;

        const parts = line.split("|");

        if (parts.length < 2) continue;

        const id = parts[0].trim();
        const likeCount = parseInt(parts[1].trim());

        if (isNaN(likeCount)) continue;

        if (likeCount >= minLike && likeCount <= maxLike) {
            result.push(
                excludeLike
                    ? id
                    : `${id}|${likeCount}`
            );
        }
    }

    document.getElementById("outputData").value = result.join("\n");
}
</script>

</body>
</html>
